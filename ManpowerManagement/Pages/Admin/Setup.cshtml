@page
@model ManpowerManagement.Pages.Admin.SetupModel
@{ViewData["Title"]="Admin";}
<h1 class="h3">Admin Setup</h1><div class="row"><div class="col-md-6"><div class="card card-body"><h2 class="h5">Create Approver</h2><form method="post" asp-page-handler="User" class="row g-2"><div class="col"><input class="form-control" name="username" placeholder="Username" required/></div><div class="col"><input class="form-control" name="password" placeholder="Temporary password" required/></div><div class="col-auto"><button class="btn btn-primary">Create</button></div></form></div></div><div class="col-md-6"><div class="card card-body"><h2 class="h5">Calendar</h2><form method="post" asp-page-handler="Calendar" class="row g-2"><div class="col-5"><input type="date" class="form-control" name="workDate" required/></div><div class="col-4"><select class="form-select" name="workshopId" asp-items="Model.Workshops"></select></div><div class="col-3"><button class="btn btn-primary">Set work day</button></div></form></div></div></div>@if(Model.Message!=null){<div class="alert alert-success mt-3">@Model.Message</div>}
