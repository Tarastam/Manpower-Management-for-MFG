@page
@model ManpowerManagement.Pages.Tickets.CreateModel
@{ViewData["Title"]="Resignation Ticket";}
<h1 class="h3">Resignation Request</h1>@if(Model.Message!=null){<div class="alert alert-success">@Model.Message</div>}
<form method="post" class="card card-body col-lg-7"><div class="mb-3"><label>Requester Employee ID</label><input class="form-control" asp-for="Input.RequesterEmployeeId" required /></div><div class="mb-3"><label>Requester shift</label><select class="form-select" asp-for="Input.RequesterShift"><option>A</option><option>B</option><option>C</option><option>Day</option></select></div><div class="mb-3"><label>Workshop</label><select class="form-select" asp-for="Input.WorkshopId" asp-items="Model.Workshops"></select></div><div class="mb-3 position-relative"><label>Employee requesting resignation</label><input type="search" id="empSearch" class="form-control" placeholder="Search by Employee ID or name..." autocomplete="off" /><input type="hidden" asp-for="Input.EmployeeId" id="empId" /><div id="empResults" class="list-group position-absolute w-100 shadow-sm" style="z-index:10;max-height:260px;overflow-y:auto"></div><span asp-validation-for="Input.EmployeeId" class="text-danger small"></span><div id="empCard" class="card mt-3 d-none"><div class="card-body py-2"><table class="table table-sm mb-0" id="empTable"></table></div></div></div><button class="btn btn-primary">Submit Ticket</button></form>

@section Scripts{<script>
(()=>{const emps=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Employees,new System.Text.Json.JsonSerializerOptions{PropertyNamingPolicy=System.Text.Json.JsonNamingPolicy.CamelCase}));
const q=document.getElementById('empSearch'),res=document.getElementById('empResults'),hid=document.getElementById('empId'),card=document.getElementById('empCard'),tbl=document.getElementById('empTable');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function show(e){hid.value=e?e.id:'';card.classList.toggle('d-none',!e);if(!e)return;
tbl.innerHTML=[['Employee ID',e.employeeId],['Name',e.fullName],['Job Grade',e.jobGrade],['Process',e.process],['Workshop',e.workshop],['Shift',e.shift],['Type',e.type],['Start Date',e.startDate],['Telephone',e.phone]].map(([k,v])=>`<tr><th class="w-25">${k}</th><td>${esc(v)}</td></tr>`).join('');}
q.addEventListener('input',()=>{show(null);const t=q.value.trim().toLowerCase();res.innerHTML='';if(!t)return;
emps.filter(e=>e.employeeId.toLowerCase().includes(t)||e.fullName.toLowerCase().includes(t)).slice(0,20).forEach(e=>{const b=document.createElement('button');b.type='button';b.className='list-group-item list-group-item-action';b.textContent=e.employeeId+' - '+e.fullName;b.onclick=()=>{q.value=b.textContent;res.innerHTML='';show(e);};res.appendChild(b);});
if(!res.children.length)res.innerHTML='<div class="list-group-item text-muted">No active employee found</div>';});
document.addEventListener('click',ev=>{if(!res.contains(ev.target)&&ev.target!==q)res.innerHTML='';});
const pre=emps.find(e=>String(e.id)===hid.value);if(pre){q.value=pre.employeeId+' - '+pre.fullName;show(pre);}else hid.value='';})();
</script>}