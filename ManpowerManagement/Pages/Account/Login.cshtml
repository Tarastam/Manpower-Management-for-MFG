@page
@model ManpowerManagement.Pages.Account.LoginModel
@{ViewData["Title"]="Login";}
<div class="card card-body col-md-5"><h1 class="h4">Admin / Approver Login</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><input class="form-control" asp-for="Input.UserName" placeholder="Username" /></div><div class="mb-3"><input class="form-control" asp-for="Input.Password" type="password" placeholder="Password" /></div><button class="btn btn-primary">Login</button></form></div>
