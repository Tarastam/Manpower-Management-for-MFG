        if (!pending.length) { byId('confirmSubmitError').hidden = false; byId('confirmSubmitError').textContent = 'All days in that date range are already submitted.'; return; }
        const futureWorkingHours = pending.find(cell => cell.dataset.date > todayIso && cell.querySelector('.cell-leave-type').value === noLeave);
        if (futureWorkingHours) { byId('confirmSubmitError').hidden = false; byId('confirmSubmitError').textContent = `Working hours for ${futureWorkingHours.dataset.date} cannot be entered in advance. Only leave can be recorded ahead of today.`; return; }
        byId('submitStartDateField').value = startIso;
        byId('submitEndDateField').value = endIso;
        const button = byId('attendanceSubmit'); button.disabled = true; button.textContent = 'Saving…';
        bootstrap.Modal.getOrCreateInstance(byId('confirmSubmitModal')).hide();
        byId('attendanceForm').submit();
    });
})();
